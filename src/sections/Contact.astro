<section id="contact" class="neu-card">
          <h2 class="text-3xl font-bold text-red-900">Let's build together!</h2>
          <form action="#" class="mt-5 max-w-3xl space-y-3">
            <label for="name" class="block font-semibold text-red-950">Name</label>
            <input type="text" id="name" name="name" required class="neu-field">

            <label for="email" class="block font-semibold text-red-950">Email</label>
            <input type="email" name="email" id="email" required class="neu-field">

            <label for="message" class="block font-semibold text-red-950">Message</label>
            <textarea name="message" id="message" rows="5" required class="neu-field"></textarea>

            <button type="submit" class="btn-primary mt-2">
              Send Message
            </button>
          </form>
        </section>